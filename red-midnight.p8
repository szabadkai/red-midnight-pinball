pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- RED: MIDNIGHT PINBALL
-- Original table for the RED cast
-- Pure rules/physics. Drawing and input live in main/renderer.
function new_game()
 g={score=0,ball=1,mult=1,round=1,phase=1,hits=0,
  red={false,false,false},sets=0,locks=0,boss=6,
  save=0,heat=0,tilt=0,charge=0,ready=true,wait=0,
  combo=0,combo_time=0,jackpots=0,won=0,skill=0,over=false}
 balls={} particles={} floats={}
 flippers={{x=39,y=191,side=1,a=0.09,old=0.09},
  {x=85,y=191,side=-1,a=0.09,old=0.09}}
 bumpers={{x=43,y=62,r=8,flash=0},
  {x=81,y=62,r=8,flash=0},{x=62,y=84,r=8,flash=0}}
 targets={{x=43,y=121,on=false,flash=0},
  {x=62,y=125,on=false,flash=0},{x=81,y=121,on=false,flash=0}}
 walls={
  {8,172,8,39},{8,39,14,20},{14,20,30,8},
  {30,8,96,8},{96,8,112,22},{112,22,123,40},
  {123,40,123,211},{112,51,112,211},
  {8,172,22,201},{22,201,39,211},
  {112,172,100,201},{100,201,85,211},
  {20,47,25,32},{25,32,33,25},
  {99,47,94,32},{94,32,89,25},
  {19,142,28,158},{28,158,37,172},
  {105,142,96,158},{96,158,87,172},
  {18,177,36,188},{106,177,88,188}}
 say("a journey after midnight",150)
end

function ball_at(x,y,vx,vy)
 local b={x=x,y=y,vx=vx,vy=vy,r=2,cd=0,trail={},age=0}
 add(balls,b)
 return b
end

function points(n,x,y)
 g.score=min(30000,g.score+n*g.mult)
 if x then add(floats,{x=x,y=y,t=45,s=tostr(n*g.mult).."00"}) end
end

function say(s,t)
 message=s message_time=t or 120
end

function burst(x,y,c,n)
 for i=1,n do
  if #particles<64 then
   local a=rnd(1) local v=0.3+rnd(1.4)
   add(particles,{x=x,y=y,vx=cos(a)*v,vy=sin(a)*v,t=16+rnd(18),c=c})
  end
 end
end

function launch()
 if not g.ready then return end
 ball_at(118,200,0,-4.5-g.charge*2)
 g.ready=false g.charge=0 g.save=480 g.skill=150
 sound(0) say("light r e d to raise the stakes",100)
end

-- Closest-point capsule contact. Also handles moving flipper surfaces.
function contact(b,ax,ay,bx,by,r,bounce,sx,sy)
 local dx,dy=bx-ax,by-ay
 local l=dx*dx+dy*dy
 local u=0
 if l>0 then u=mid(0,((b.x-ax)*dx+(b.y-ay)*dy)/l,1) end
 local px,py=ax+dx*u,ay+dy*u
 local nx,ny=b.x-px,b.y-py
 local rr=b.r+r
 -- Reject before squaring: long table distances overflow 16.16.
 if abs(nx)>=rr or abs(ny)>=rr then return false end
 local d=sqrt(nx*nx+ny*ny)
 if d>=rr then return false end
 if d<0.001 then nx=0 ny=-1 d=1 else nx=nx/d ny=ny/d end
 b.x=px+nx*(rr+0.03) b.y=py+ny*(rr+0.03)
 sx=(sx or 0)*u sy=(sy or 0)*u
 local speed=(b.vx-sx)*nx+(b.vy-sy)*ny
 if speed<0 then
  b.vx=b.vx-(1+bounce)*speed*nx
  b.vy=b.vy-(1+bounce)*speed*ny
 end
 return true,u,nx,ny
end

function multiball()
 if #balls<3 then
  ball_at(36,104,1.5,-2)
  if #balls<3 then ball_at(88,104,-1.5,-2.3) end
 end
 g.save=600 g.locks=0
 sound(5) shake=6 say("moonlight multiball!",180)
 burst(62,80,12,30)
end

function lane(b,i)
 if b.cd>0 then return end
 b.cd=12
 if not g.red[i] then
  g.red[i]=true points(5,38+(i-1)*24,30) sound(2)
  burst(b.x,b.y,10,8)
  if g.skill>0 then
   g.skill=0 points(25,b.x,b.y) sound(4)
   say("moonshot! 2500 skill bonus",120)
  end
 end
 if g.red[1] and g.red[2] and g.red[3] then
  g.red={false,false,false} g.mult=min(5,g.mult+1)
  g.sets=(g.sets+1)%100 points(15,62,40)
  if g.sets%2==0 then multiball()
  else say("red lanes! multiplier up",150) sound(4) end
 end
end

function defeat_hart()
 g.won=min(999,g.won+1) points(150,62,75) g.round=min(99,g.round+1)
 g.phase=1 g.hits=0 g.boss=6+min(6,g.round-1)
 g.mult=min(5,g.mult+1) g.save=600
 for t in all(targets) do t.on=false end
 sound(7) shake=8 say("dawn breaks! the wood is free",240)
 burst(62,70,10,48)
end

function damage_hart(x,y)
 if g.phase~=3 then return end
 g.boss=g.boss-1 points(10,x,y) sound(6)
 if g.boss<=0 then defeat_hart() end
end

function hit_bumper(b,p)
 if b.cd>0 then return end
 local dx,dy=b.x-p.x,b.y-p.y
 local d=max(0.1,sqrt(dx*dx+dy*dy))
 b.vx=dx/d*3.2 b.vy=dy/d*3.2-0.25 b.cd=8
 p.flash=12 shake=2 g.combo=min(99,g.combo+1) g.combo_time=120
 points(1+min(5,g.combo),p.x,p.y) sound(1)
 burst(p.x,p.y,14,10)
 if g.phase==1 then
  g.hits=g.hits+1
  if g.hits>=6 then
   g.phase=2 say("wolf defeated! shoot cottage",180) sound(4)
   points(30,62,80)
  end
 elseif g.phase==3 then damage_hart(p.x,p.y) end
end

function scoop(b,kind)
 if b.cd>0 then return end
 b.cd=45 b.vy=-2.8 b.vx=kind==1 and 1.8 or -1.8
 points(5,b.x,b.y) burst(b.x,b.y,12,12) sound(3)
 if kind==1 and g.phase==2 then
  g.phase=3 multiball() say("grandma safe! break the hart",180)
  points(50,b.x,b.y)
 elseif kind==2 and #balls>1 then
  g.jackpots=min(999,g.jackpots+1) points(50,b.x,b.y)
  say("moonlight jackpot!",120) sound(7) shake=5
 else
  g.locks=g.locks+1
  if g.locks>=3 then multiball()
  else say("moon lock "..g.locks.."/3",90) end
 end
end

function tick_ball(b)
 b.cd=max(0,b.cd-1) b.age=min(30000,b.age+1)
 add(b.trail,{x=b.x,y=b.y})
 if #b.trail>7 then deli(b.trail,1) end
 for step=1,4 do
  b.vy=min(5.8,b.vy+0.026)
  b.vx=mid(-5.8,b.vx*0.9994,5.8)
  b.vy=max(-6.5,b.vy)
  b.x=b.x+b.vx/4 b.y=b.y+b.vy/4
  -- One-way shooter gate turns the plunger shot into the upper orbit.
  if b.x>112 and b.y<44 and b.vy<0 then
   b.x=109 b.vx=-2.7 b.vy=-2.5
  end
  for w in all(walls) do contact(b,w[1],w[2],w[3],w[4],0.7,0.72) end
  for f in all(flippers) do
   local a=f.old+(f.a-f.old)*step/4
   local ex,ey=f.x+f.side*cos(a)*19,f.y-sin(a)*19
   local ox,oy=f.x+f.side*cos(f.old)*19,f.y-sin(f.old)*19
   local tx,ty=f.x+f.side*cos(f.a)*19,f.y-sin(f.a)*19
   local hit,u,nx,ny=contact(b,f.x,f.y,ex,ey,2,0.62,tx-ox,ty-oy)
   if hit and f.active and ny<0 and g.tilt==0 then
    -- A fresh stroke launches; held bats support/cradle without repeat kicks.
    if f.a-f.old < -0.002 then
     b.vy=min(b.vy,-3.6-u*2)
     b.vx=f.side*(0.6+u*2.1)
    end
   end
  end
  for p in all(bumpers) do
   if contact(b,p.x,p.y,p.x,p.y,p.r,0.9) and g.tilt==0 then hit_bumper(b,p) end
  end
  if g.tilt>0 then
   for t in all(targets) do contact(b,t.x-4,t.y,t.x+4,t.y,1,0.9) end
  else
   for i=1,3 do
    if abs(b.x-(38+(i-1)*24))<7 and abs(b.y-31)<3 then lane(b,i) end
   end
   for t in all(targets) do
    if contact(b,t.x-4,t.y,t.x+4,t.y,1,0.9) and b.cd==0 then
     t.on=true t.flash=12 b.cd=8 b.vy=-abs(b.vy)-0.5
     points(3,t.x,t.y) sound(2) burst(t.x,t.y,10,6)
     if targets[1].on and targets[2].on and targets[3].on then
      for q in all(targets) do q.on=false end
      points(20,t.x,t.y) damage_hart(t.x,t.y)
      if g.phase~=3 then g.save=max(g.save,300) say("lanterns lit! ball save",100) end
     end
    end
   end
   for i=1,2 do
    local x=i==1 and 24 or 100
    if abs(b.x-x)<5 and abs(b.y-110)<5 then scoop(b,i) end
   end
   -- Slingshots: contact on their facing edges.
   for i=1,2 do
    local x=i==1 and 30 or 94
    if contact(b,x,163,x+(i==1 and 12 or -12),180,1,1) and b.cd==0 then
     b.vx=i==1 and 2.6 or -2.6 b.vy=-2.3 b.cd=10
     points(1) sound(1) burst(b.x,b.y,9,6)
    end
   end
  end
 end
 if b.y>218 then
  del(balls,b)
  if g.save>0 and g.tilt==0 then
   ball_at(118,200,0,-6) sound(3) say("lantern save",100)
  elseif #balls==0 then
   g.wait=100 g.mult=max(1,g.mult-1) g.combo=0
   say("into the dark...",100) sound(8)
  end
 end
end

function ball_contact(a,b)
 local dx,dy=b.x-a.x,b.y-a.y
 if abs(dx)>=4 or abs(dy)>=4 then return end
 local d=sqrt(dx*dx+dy*dy)
 if d>=4 then return end
 if d<0.01 then dx=1 dy=0 d=1 else dx=dx/d dy=dy/d end
 local separation=(4-d)/2+0.01
 a.x=a.x-dx*separation a.y=a.y-dy*separation
 b.x=b.x+dx*separation b.y=b.y+dy*separation
 local speed=(a.vx-b.vx)*dx+(a.vy-b.vy)*dy
 if speed>0 then
  a.vx=a.vx-speed*dx a.vy=a.vy-speed*dy
  b.vx=b.vx+speed*dx b.vy=b.vy+speed*dy
 end
end

function tick_game(left,right,plunge,nudge)
 if g.over then return end
 g.save=max(0,g.save-1) g.heat=max(0,g.heat-0.004) g.skill=max(0,g.skill-1)
 g.tilt=max(0,g.tilt-1)
 g.combo_time=max(0,g.combo_time-1)
 if g.combo_time==0 then g.combo=0 end
 if g.wait>0 then
  g.wait=g.wait-1
  if g.wait==0 then
   g.ball=g.ball+1 g.tilt=0 g.heat=0
   if g.ball>3 then
    g.over=true sound(8)
    if g.score>best then best=g.score dset(0,best) end
   else g.ready=true say("ball "..g.ball.." - hold x to launch",150) end
  end
 end
 for i,f in ipairs(flippers) do
  f.old=f.a f.active=(i==1 and left or i==2 and right) and g.tilt==0
  local target=f.active and -0.075 or 0.09
  f.a=f.a+mid(-0.035,target-f.a,0.021)
  if f.active and f.old==0.09 then
   sound(9)
   if i==1 then g.red={g.red[2],g.red[3],g.red[1]}
   else g.red={g.red[3],g.red[1],g.red[2]} end
  end
 end
 if g.ready then
  if plunge then g.charge=min(1,g.charge+0.025)
  elseif g.charge>0 then launch() end
 end
 if nudge and #balls>0 and g.tilt==0 then
  g.heat=g.heat+1 shake=4 sound(10)
  if g.heat>2.6 then
   g.tilt=240 g.save=0 say("tilt! flippers disabled",160)
  else
   for b in all(balls) do b.vy=b.vy-1.6 b.vx=b.vx+(left and 0.8 or -0.8) end
   say(g.heat>1.6 and "danger! let the table settle" or "nudge",60)
  end
 end
 -- New multiballs enter on the next frame, never while iterating collisions.
 local active={}
 for b in all(balls) do add(active,b) end
 for b in all(active) do tick_ball(b) end
 for i=1,#balls-1 do
  for j=i+1,#balls do ball_contact(balls[i],balls[j]) end
 end
 for p in all(bumpers) do p.flash=max(0,p.flash-1) end
 for t in all(targets) do t.flash=max(0,t.flash-1) end
end

-- Palette, table artwork, camera, particles and menus. No scoring here.
function center(s,y,c)
 print(s,64-#s*2,y,c)
end

function label(s,x,y,c)
 print(s,x+1,y+1,0) print(s,x,y,c)
end

function number(n)
 if n==0 then return "000000" end
 local s=tostr(flr(n)).."00"
 while #s<6 do s="0"..s end
 return s
end

function actor(id,frame,x,y,flip,scale)
 local row=id*24
 local size=24
 if id==3 then row=80 size=32 end
 sspr(frame*size,row,size,size,x,y,size*(scale or 1),size*(scale or 1),flip)
end

function rail(x1,y1,x2,y2,c)
 for i=-2,2 do line(x1+i,y1,x2+i,y2,0) end
 line(x1,y1+1,x2,y2+1,4)
 line(x1,y1,x2,y2,c or 9)
end

function lamp(x,y,c,on)
 circfill(x,y,3,0) circ(x,y,3,4)
 circfill(x,y,1,on and c or 5)
 if on then pset(x,y-1,7) end
end

function arrow(x,y,c)
 line(x,y,x-3,y+4,c) line(x,y,x+3,y+4,c)
 line(x,y+1,x,y+7,c)
end

function pine(x,y,h,c)
 line(x,y,x,y+h,5)
 for j=0,h-3 do
  local w=flr(j/4)+1-flr((j%8)/3)
  line(x-w,y+j,x+w,y+j,c)
 end
end

function backdrop()
 rectfill(0,0,127,224,0)
 -- Velvet playfield, gold inlay, hand-etched woodland.
 rectfill(9,21,111,205,1)
 ovalfill(9,8,112,63,1)
 fillp(0xa5a5) rectfill(13,35,107,185,0) fillp()
 for y=20,201,8 do
  for x=14,107,8 do
   line(x,y-1,x+1,y,1) line(x+1,y,x,y+1,1)
  end
 end
 for y=34,174,18 do
  pine(14,y,13,3) pine(106,y+5,13,3)
  pset(12,y-2,11) pset(108,y+2,11)
 end
 for w in all(walls) do rail(w[1],w[2],w[3],w[4],9) end
 -- Inner orbit, riveted shooter channel.
 line(14,49,14,133,5) line(108,49,108,133,5)
 for y=57,201,12 do pset(115,y,5) pset(121,y,13) end
 for y=22,182,20 do
  circfill(5,y,2,4) pset(5,y-1,10)
  circfill(126,y,2,4) pset(126,y-1,10)
 end
 for i=1,3 do
  local x=38+(i-1)*24
  line(x-10,21,x-10,39,13)
  lamp(x,30,10,false)
  label(sub("red",i,i),x-1,20,6)
 end
 -- Moon above the orbit.
 circfill(62,15,6,13) circfill(65,13,5,1)
 pset(60,13,7)
 -- Center medallion / engraved crimson hood.
 oval(33,98,91,157,3) oval(36,100,88,154,5)
 line(62,98,91,128,3) line(91,128,62,157,3)
 line(62,157,33,128,3) line(33,128,62,98,3)
 label("r e d",53,155,14)
 -- Brass filigree and little enamel stars.
 for i=0,7 do
  local a=i/8
  local x,y=62+cos(a)*27,128+sin(a)*29
  pset(x,y,9)
 end
 for i=0,1 do
  local x=i==0 and 28 or 96
  line(x,72,x,89,4) line(x-2,79,x+2,79,9)
  pset(x,77,10) pset(x,84,9)
 end
 -- Cottage and moon well.
 for i=1,2 do
  local x=i==1 and 24 or 100
  circfill(x,110,8,0) circ(x,110,8,13)
  circ(x,110,5,5)
 end
 line(16,102,24,96,9) line(24,96,32,102,9)
 rect(19,101,29,105,4)
 pset(22,103,10) pset(26,103,10)
 circfill(100,99,4,12) circfill(102,97,3,1)
 -- Slingshots and inlane arrows.
 for i=1,2 do
  local x=i==1 and 30 or 94
  local d=i==1 and 1 or -1
  for j=0,7 do line(x,163+j*2,x+d*j,177+j,2) end
  rail(x,163,x+d*12,180,14)
  rail(x,163,x-d*4,181,8)
  line(x-d*4,181,x+d*12,180,4)
  arrow(x-d*10,166,12)
  lamp(x-d*7,190,11,false)
 end
 label("lantern",48,171,5)
 label("wood",54,178,13)
 for y=206,218,3 do line(42,y,82,y,2) end
 label("midnight",46,210,8)
end

-- Pre-render the intricate 128x256 table into spare RAM once. Scrolling is
-- one contiguous framebuffer copy; the frame budget goes to ball physics.
function cache_table()
 clip() camera() backdrop() memcpy(0x8000,0x6000,8192)
 camera(0,128) backdrop() memcpy(0xa000,0x6000,8192)
 camera()
end

function draw_table()
 memcpy(0x6000,0x8000+view_y*64,8192)
 for i=1,3 do
  local x=38+(i-1)*24
  lamp(x,30,10,g.red[i])
  label(sub("red",i,i),x-1,20,g.red[i] and 10 or 6)
 end
 for i=1,2 do
  local x=i==1 and 24 or 100
  local lit=i==1 and g.phase==2 or i==2 and #balls>1
  if lit then
   circ(x,110,8,12) circ(x,110,5,7)
   arrow(x,94+sin(tick/40),12)
  end
  lamp(i==1 and 23 or 101,190,11,g.save>0)
 end
 actor(0,flr(tick/18)%4,50,131)
 local frame=flr(tick/16)%4
 -- Character guardians react to their mission.
 if g.phase==3 then
  actor(3,flr(tick/20)%2,47,39)
  for i=1,g.boss do pset(48+i*2,76,8) end
 else
  actor(2,frame,50,42)
 end
 actor(1,frame,12,76)
 for p in all(bumpers) do
  local c=p.flash>0 and 7 or (g.phase==3 and 8 or 12)
  circfill(p.x+1,p.y+3,10,0)
  circfill(p.x,p.y,9,5) circ(p.x,p.y,9,13)
  circfill(p.x,p.y,7,1) circ(p.x,p.y,7,c)
  circfill(p.x,p.y,4,p.flash>0 and 10 or 3)
  line(p.x-2,p.y,p.x+2,p.y,c) line(p.x,p.y-2,p.x,p.y+2,c)
  pset(p.x-3,p.y-5,7)
  if p.flash>0 then circ(p.x,p.y,10+(12-p.flash)/2,c) end
 end
 for i,t in ipairs(targets) do
  rectfill(t.x-5,t.y-2,t.x+5,t.y+3,0)
  rect(t.x-4,t.y-1,t.x+4,t.y+2,t.flash>0 and 7 or 9)
  line(t.x-3,t.y,t.x+3,t.y,t.on and 10 or 4)
  lamp(t.x,t.y-8,10,t.on)
 end
 for f in all(flippers) do
  local x,y=f.x+f.side*cos(f.a)*19,f.y-sin(f.a)*19
  for j=-2,2 do line(f.x,f.y+j+1,x,y+j+1,0) end
  for j=-1,1 do line(f.x,f.y+j,x,y+j,f.active and 14 or 8) end
  line(f.x,f.y-2,x,y-2,f.active and 7 or 15)
  circfill(f.x,f.y,3,2) circ(f.x,f.y,3,14) pset(f.x,f.y-1,7)
 end
 if g.ready then
  local y=197+g.charge*6
  circfill(118,y,2,7) pset(117,y-1,12)
  for j=0,4 do line(115,y+4+j*2,121,y+4+j*2,5) end
  rectfill(115,218-g.charge*20,121,218,10)
 end
 -- Animated orbit chase lamps.
 for i=0,9 do
  local a=i/20+0.01
  local x,y=62+cos(a)*50,48+sin(a)*36
  pset(x,y,(flr(tick/5)%10)==i and 7 or 4)
 end
 for b in all(balls) do
  for i,p in ipairs(b.trail) do
   circfill(p.x,p.y,(i-1)/5,i<4 and 5 or 12)
  end
  circfill(b.x+1,b.y+2,2,0)
  circfill(b.x,b.y,2,6) pset(b.x-1,b.y-1,7) pset(b.x,b.y,7)
 end
 for p in all(particles) do pset(p.x,p.y,p.c) end
 for f in all(floats) do label(f.s,f.x-#f.s*2,f.y,10) end
end

function objective()
 if g.tilt>0 then return "tilt - wait for the table" end
 if g.ready then return "hold x/down - release to shoot" end
 if g.phase==1 then return "wolf bumpers  "..g.hits.."/6" end
 if g.phase==2 then return "rescue grandma: left cottage" end
 return "briar hart  "..g.boss.." hits left"
end

function hud()
 camera() clip()
 rectfill(0,0,127,13,0) line(0,13,127,13,4)
 label(number(g.score),3,2,7)
 label("x"..g.mult,48,2,10)
 label("ball "..min(3,g.ball).."/3",91,2,6)
 local s=objective()
 if message_time>0 then s=message end
 print(s,3,8,g.tilt>0 and 8 or 13)
 rectfill(0,119,127,127,0) line(0,119,127,119,4)
 if g.save>0 and not g.ready then
  print("save "..ceil(g.save/60),3,122,11)
 else print("z nudge",3,122,13) end
 if #balls>1 then print("multiball",48,122,12)
 else print("up:look",48,122,5) end
 print("<  >",108,122,14)
 -- Edge indicators keep offscreen multiballs trackable.
 for b in all(balls) do
  local y=b.y-cam
  if y<16 then arrow(mid(6,b.x,121),16,7) end
  if y>116 then line(b.x-2,114,b.x,117,7) line(b.x,117,b.x+2,114,7) end
 end
end

function forest()
 cls(0)
 for i=0,45 do
  local x=(i*37+11)%128 local y=(i*23)%90
  pset(x,y,(i+flr(tick/45))%7==0 and 7 or 5)
 end
 circfill(91,28,18,13) circfill(97,23,17,1)
 for i=0,8 do pine(i*18-7,25+(i*7)%27,76,1) end
 for i=0,6 do pine(i*25-9,58+(i*13)%30,55,3) end
 ovalfill(-20,95,147,151,1)
 for i=0,30 do
  local x=i*17%128 local y=100+i*7%27
  line(x,y,x+2,y,3)
 end
 for i=1,12 do
  local x=(i*19+tick/12)%128 local y=70+(i*23)%45+sin(tick/180+i)*4
  pset(x,y,i%2==0 and 10 or 12)
 end
end

function title_screen()
 forest()
 -- Tall custom lettering, drawn from the native font at 2x using scratch RAM.
 rectfill(0,0,29,7,0) print("r e d",0,0,8)
 memcpy(0x4300,0x6000,512)
 rectfill(0,0,29,7,0)
 for y=0,5 do
  for x=0,21 do
   local v=peek(0x4300+y*64+flr(x/2))
   local c=x%2==0 and v%16 or flr(v/16)
   if c==8 then rectfill(22+x*4,14+y*4,25+x*4,17+y*4,2)
    rectfill(21+x*4,12+y*4,24+x*4,15+y*4,y<3 and 14 or 8) end
  end
 end
 center("m i d n i g h t",43,15)
 line(18,52,109,52,4) center("p i n b a l l",56,10)
 actor(0,flr(tick/18)%4,24,73,false,1.4)
 actor(2,flr(tick/18)%4,73,73,true,1.4)
 circfill(64,86+sin(tick/90)*5,3,7)
 pset(63,84+sin(tick/90)*5,12)
 rectfill(14,106,113,117,0) rect(14,106,113,117,4)
 center("x play    z field guide",109,flr(tick/35)%2==0 and 15 or 7)
 center("best "..number(best),122,13)
end

function guide_screen()
 cls(1) rect(3,3,124,124,4)
 center("field guide  "..page.."/2",9,10)
 line(12,19,115,19,5)
 if page==1 then
  label("the art of the silver ball",10,26,15)
  print("left / right: flippers\nx/down: hold, then release\n        to launch\nz: nudge (3 fast = tilt!)\nup: see upper playfield\nesc / enter: pause",10,39,6)
  print("flippers shift red lights.\n8 seconds of launch save.\ncatch on a held flipper,\nrelease, then shoot again.",10,84,13)
 else
  print("1. defeat the wolf\n   hit six blue bumpers.\n2. save grandmother\n   shoot the left cottage.\n3. break the briar hart\n   hit bumpers + lanterns.",10,27,6)
  print("red lanes: multiplier up.\n2 sets or 3 moon locks:\nthree-ball multiball!\nright well: 5000 jackpot.\n3 lanterns: ball save.",10,76,13)
 end
 center("<> page   x play   z back",115,14)
end

function results_screen()
 rectfill(9,31,118,101,0) rect(9,31,118,101,9)
 center(g.won>0 and "dawn in lantern wood" or "the forest remembers",39,14)
 center(number(g.score),53,7)
 center("best "..number(best),65,10)
 center("harts "..g.won.."   jackpots "..g.jackpots,77,13)
 center("x again   z title",91,6)
end

function sound(n)
 if not muted then sfx(n,3) end
end

function _init()
 cartdata("red_midnight_pinball_v1")
 best=dget(0) muted=dget(1)==1 motion=dget(2)~=1
 tick=0 cam=100 shake=0 message_time=0 page=1 state="title" menu_delay=0
 new_game()
 cache_table()
 if not muted then music(0,800,7) end
 menuitem(1,"sound on/off",function()
  muted=not muted dset(1,muted and 1 or 0)
  if muted then music(-1) sfx(-1,3) else music(0,400,7) end
 end)
 menuitem(2,"motion on/off",function() motion=not motion dset(2,motion and 0 or 1) end)
 menuitem(3,"field guide",function() previous=state state="guide" menu_delay=12 end)
 menuitem(4,"title screen",function() state="title" menu_delay=12 end)
end

function start_game()
 new_game() state="play" cam=100 launch_armed=false
end

function _update60()
 tick=(tick+1)%7200
 if menu_delay>0 then menu_delay=menu_delay-1 return end
 if state=="title" then
  if btnp(5) then start_game()
  elseif btnp(4) then state="guide" previous="title" end
 elseif state=="guide" then
  if btnp(0) or btnp(1) then page=3-page sound(2) end
  if btnp(4) then state=previous or "title"
  elseif btnp(5) then
   if previous=="play" then state="play" else start_game() end
  end
 elseif g.over then
  if btnp(5) then start_game() elseif btnp(4) then state="title" end
 else
  local plunge=btn(5) or btn(3)
  if not launch_armed then
   if not plunge then launch_armed=true end
   plunge=false
  end
  tick_game(btn(0),btn(1),plunge,btnp(4))
  local target=100
  if #balls>0 then
   local lowest=0
   for b in all(balls) do
    if b.x<112 then lowest=max(lowest,b.y+b.vy*5) end
   end
   target=mid(0,lowest-63,100)
  end
  if btn(2) then target=0 end
  cam=cam+(target-cam)*(motion and 0.16 or 1)
 end
 if state=="play" then
  message_time=max(0,message_time-1) shake=max(0,shake-0.3)
  for p in all(particles) do
   p.x=p.x+p.vx p.y=p.y+p.vy p.vy=p.vy+0.035 p.t=p.t-1
   if p.t<=0 then del(particles,p) end
  end
  for f in all(floats) do
   f.y=f.y-0.2 f.t=f.t-1
   if f.t<=0 then del(floats,f) end
  end
 end
end

function _draw()
 camera() clip()
 if state=="title" then title_screen()
 elseif state=="guide" then guide_screen()
 else
  cls(0) clip(0,14,128,105)
  local jitter=motion and shake>0 and sin(tick*0.37)*shake/2 or 0
  view_y=mid(0,flr(cam+jitter),104)
  camera(0,view_y) draw_table() hud()
  if g.over then results_screen() end
 end
end

